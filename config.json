{
    "remote": "your-rclone-remote",

    "scheduler": {
        "enabled": true,
        "interval_minutes": 5
    },

    "defaults": {
        "check_access": true,
        "max_delete": 10,
        "tpslimit": 5,
        "tpslimit_burst": 5,
        "transfers": 4,
        "checkers": 8
    },

    "folders": [
        {
            "name": "Example_Folder",
            "local_path": "/path/to/local/Example_Folder",
            "remote_path": "Example_Folder",
            "service": "rclone-example_folder-bisync.service",
            "enabled": true
        },
        {
            "name": "Another_Folder",
            "local_path": "/path/to/local/Another_Folder",
            "remote_path": "Another_Folder",
            "service": "rclone-another_folder-bisync.service",
            "enabled": false
        }
    ]
}